<Window x:Class="Eloquence.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Eloquence Dashboard" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar with Status -->
        <Grid Grid.Row="0" Margin="10">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Eloquence" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{Binding RecordingButtonText}" Command="{Binding ToggleRecordingCommand}" Padding="10,5" Margin="0,0,10,0" Background="{DynamicResource DangerAccentBrush}" Foreground="White" BorderBrush="{DynamicResource DangerAccentBrush}" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Run Evaluation Now" Command="{Binding RunEvaluationCommand}" Padding="10,5" Margin="0,0,10,0" Background="{DynamicResource SecondaryAccentBrush}" Foreground="White" BorderBrush="{DynamicResource SecondaryAccentBrush}" FontWeight="SemiBold"/>
                <Button Content="Toggle Theme" Click="ThemeToggle_Click" Padding="10,5" Margin="0,0,10,0" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                <Button Content="Settings" Click="SettingsButton_Click" Padding="10,5" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <!-- Custom TabControl Style for Beauty -->
        <TabControl Grid.Row="1" Grid.RowSpan="3" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,10,0,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Padding="15,8" Margin="2,0" Background="{DynamicResource TabBackgroundBrush}" CornerRadius="8,8,0,0">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TabSelectedForegroundBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}"/>
                </Style>
            </TabControl.Resources>
            
            <!-- DASHBOARD TAB -->
            <TabItem Header="Dashboard" Padding="15,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        
                        <!-- Top: Composite Scores -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- English Summary -->
                            <Border Grid.Column="0" Background="#1E3A8A" Margin="0,0,10,0" CornerRadius="12" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="English Communication" FontSize="18" FontWeight="Bold" Foreground="#BFDBFE" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="1" Text="{Binding CurrentEngAvg, StringFormat='{}{0}'}" FontSize="48" FontWeight="Black" Foreground="White"/>
                                    <Border Grid.Row="2" Background="{Binding EngLevelColor}" HorizontalAlignment="Left" CornerRadius="4" Padding="8,4" Margin="0,5,0,10">
                                        <TextBlock Text="{Binding EngLevel}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                    </Border>
                                    <TextBlock Grid.Row="3" Text="{Binding EngDelta}" FontSize="14" Foreground="#93C5FD"/>
                                </Grid>
                            </Border>

                            <!-- Tech Summary -->
                            <Border Grid.Column="1" Background="#064E3B" Margin="10,0,0,0" CornerRadius="12" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Technical Mastery" FontSize="18" FontWeight="Bold" Foreground="#A7F3D0" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="1" Text="{Binding CurrentTechAvg, StringFormat='{}{0}'}" FontSize="48" FontWeight="Black" Foreground="White"/>
                                    <Border Grid.Row="2" Background="{Binding TechLevelColor}" HorizontalAlignment="Left" CornerRadius="4" Padding="8,4" Margin="0,5,0,10">
                                        <TextBlock Text="{Binding TechLevel}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                    </Border>
                                    <TextBlock Grid.Row="3" Text="{Binding TechDelta}" FontSize="14" Foreground="#6EE7B7"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Middle: Skill Cards -->
                        <TextBlock Text="Detailed Skills" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding SkillCards}" Margin="0,0,0,20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Margin="5" Padding="15">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                <Border Grid.Column="1" Background="{Binding LevelColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                            
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,15" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Score}" FontSize="32" FontWeight="Black" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                <TextBlock Text="/100" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                                            </StackPanel>
                                            
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Value="{Binding Score}" Maximum="100" Height="6" Foreground="{Binding LevelColor}" Background="{DynamicResource CardBorderBrush}" BorderThickness="0" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DeltaText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding LevelColor}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom: Historical Trend Charts -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="English Metrics Over Time" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15"/>
                                    <lvc:CartesianChart Series="{Binding EngTrendSeries}" XAxes="{Binding TrendXAxes}" Height="250" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Technical Metrics Over Time" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15"/>
                                    <lvc:CartesianChart Series="{Binding TechTrendSeries}" XAxes="{Binding TrendXAxes}" Height="250" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TELEMETRY LOGS TAB -->
            <TabItem Header="Telemetry Logs" Padding="15,5" Visibility="{Binding IsTelemetryEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LLM Token Usage &amp; Telemetry" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedTelemetryDate}" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="All Time" Command="{Binding ShowAllTelemetryCommand}" Padding="10,5" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Total Tokens" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TelTotalTokens}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Total Calls" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TelTotalCalls}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Avg Tokens/Call" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TelAvgTokens}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Success Rate" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TelSuccessRate}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    
                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredLlmLogs}" AutoGenerateColumns="False" 
                              IsReadOnly="True" HeadersVisibility="Column" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time (UTC)" Binding="{Binding Timestamp, StringFormat='{}{0:G}'}" Width="150"/>
                            <DataGridTextColumn Header="Agent" Binding="{Binding AgentName}" Width="120"/>
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="150"/>
                            <DataGridTextColumn Header="Prompt Tokens" Binding="{Binding PromptTokens}" Width="120"/>
                            <DataGridTextColumn Header="Completion Tokens" Binding="{Binding CompletionTokens}" Width="130"/>
                            <DataGridTextColumn Header="Total Tokens" Binding="{Binding TotalTokens}" Width="120"/>
                            <DataGridCheckBoxColumn Header="Success" Binding="{Binding IsSuccess}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- REPETITION WORDS TAB -->
            <TabItem Header="Repetition Words" Padding="15,5">
                <ListBox ItemsSource="{Binding RepetitiveWords}" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderThickness="0" Margin="10" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,15,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Repeated Word" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Word}" FontWeight="Black" FontSize="24" Foreground="{DynamicResource DangerAccentBrush}"/>
                                        <Border Background="{DynamicResource DangerAccentBrush}" CornerRadius="10" Padding="8,4" Margin="0,5,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Count, StringFormat='Used {0}x'}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                        <TextBlock Text="Better Alternatives:" Foreground="{DynamicResource SecondaryAccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <ItemsControl ItemsSource="{Binding SuggestedAlternatives}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryAccentBrush}" Margin="0,2,0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- VOCABULARY UPGRADES TAB -->
            <TabItem Header="Vocabulary" Padding="15,5">
                <ListBox ItemsSource="{Binding WeakVocabulary}" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderThickness="0" Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,15,0,20">
                                <StackPanel>
                                    <TextBlock Text="Weak Word Used:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding OriginalPhrase}" TextWrapping="Wrap" FontSize="16" Foreground="#F59E0B" Margin="0,0,0,10" FontStyle="Italic"/>
                                    
                                    <TextBlock Text="Sophisticated Alternative:" Foreground="{DynamicResource SecondaryAccentBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding ImprovedPhrase}" TextWrapping="Wrap" FontSize="22" FontWeight="Black" Foreground="{DynamicResource SecondaryAccentBrush}" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource CardBackgroundBrush}" Padding="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- ENGLISH IMPROVEMENTS TAB -->
            <TabItem Header="English Improvements" Padding="15,5">
                <ListBox ItemsSource="{Binding PhraseImprovements}" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderThickness="0" Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,15,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Score: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding Score}" FontWeight="Bold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryAccentBrush}"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <TextBlock Text="You said:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding OriginalPhrase}" TextWrapping="Wrap" FontSize="16" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15" FontStyle="Italic"/>
                                    
                                    <TextBlock Text="Instead, say:" Foreground="{DynamicResource SecondaryAccentBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding ImprovedPhrase}" TextWrapping="Wrap" FontSize="26" FontWeight="Black" Foreground="{DynamicResource SecondaryAccentBrush}" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource CardBackgroundBrush}" Padding="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- TECH FEEDBACK TAB -->
            <TabItem Header="Tech Feedback" Padding="15,5">
                <ListBox ItemsSource="{Binding TechMistakes}" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderThickness="0" Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,15,0,20">
                                <StackPanel>
                                    <TextBlock Text="You said:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding WhatYouSaid}" TextWrapping="Wrap" FontSize="16" Foreground="{DynamicResource DangerAccentBrush}" Margin="0,0,0,15"/>
                                    
                                    <TextBlock Text="Technically correct:" Foreground="{DynamicResource SecondaryAccentBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding WhatYouShouldSay}" TextWrapping="Wrap" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SecondaryAccentBrush}" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="{Binding WhyItMatters}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource CardBackgroundBrush}" Padding="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- TRANSCRIPTS TAB -->
            <TabItem Header="Transcripts" Padding="15,5">
                <ListBox ItemsSource="{Binding Transcripts}" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderThickness="0" Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding Date, StringFormat='{}{0:D}'}" FontWeight="Bold" Foreground="#60A5FA" FontSize="14"/>
                                        <TextBlock Text=" (" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="5,0,0,0"/>
                                        <TextBlock Text="{Binding StartTime, StringFormat='{}{0:t}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                        <TextBlock Text=" - " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                        <TextBlock Text="{Binding EndTime, StringFormat='{}{0:t}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                        <TextBlock Text=")" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                        
                                        <TextBlock Text=" • Evaluated" Foreground="{DynamicResource SecondaryAccentBrush}" FontSize="12" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEvaluated}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=" • Pending Evaluation" Foreground="#F59E0B" FontSize="12" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEvaluated}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" LineHeight="22" Foreground="{DynamicResource AppForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

