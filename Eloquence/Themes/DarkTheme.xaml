<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="DangerAccentBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
    
    <!-- TabControl Styles -->
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TabForegroundBrush" Color="#D4D4D8"/>
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#FFFFFF"/>

    <!-- Chart Axises -->
    <SolidColorBrush x:Key="ChartAxisBrush" Color="#D4D4D8"/>
</ResourceDictionary>
