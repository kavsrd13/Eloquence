<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="DangerAccentBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    
    <!-- TabControl Styles -->
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TabForegroundBrush" Color="#374151"/>
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#FFFFFF"/>

    <!-- Chart Axises -->
    <SolidColorBrush x:Key="ChartAxisBrush" Color="#6B7280"/>
</ResourceDictionary>
